{
  "name": "eva-info-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "npm run build:web",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply eva-info-api-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply eva-info-api-db --local",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.9.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.33.1"
  }
}
